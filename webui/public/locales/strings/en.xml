    <string name="toggle_hide_mnts_late_desc">Compatibility option. Leave off to avoid app and isolated-process mount-table drift.</string>
    <string name="toggle_allow_broad_umount">Allow whole-partition kernel umounts</string>
    <string name="toggle_allow_broad_umount_desc">Compatibility option. Leave off to quarantine broad legacy targets such as /system_ext. Reboot after changing.</string>
