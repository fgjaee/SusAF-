    <string name="toggles_title">Toggles</string>
    <string name="toggles_description">Staged kernel flags for mount visibility, logging, and AVC context sanitation.</string>
    <string name="toggle_hide_mnts">Early-boot mount guard</string>
    <string name="toggle_hide_mnts_desc">Temporarily filters Sus mounts during post-fs-data so zygote does not cache them.</string>
    <string name="toggle_hide_mnts_late">Keep blanket filtering after boot</string>
    <string name="toggle_hide_mnts_late_desc">Compatibility option. Leave off to avoid app and isolated-process mount-table drift.</string>
    <string name="toggle_allow_broad_umount">Allow whole-partition kernel umounts</string>
    <string name="toggle_allow_broad_umount_desc">Compatibility option. Leave off to quarantine broad legacy targets such as /system_ext. Reboot after changing.</string>
    <string name="toggle_enable_log">Enable SuSFS Log</string>
    <string name="toggle_enable_log_desc">Turns on susfs' own kernel logging.</string>
    <string name="toggle_avc_spoof">Spoof AVC 'su' Context</string>
    <string name="toggle_avc_spoof_desc">Hides the su domain from AVC log enumeration.</string>
